# Copy to local.env (git-ignored) and fill in your own values.
# Used by scripts/deploy-pi.sh and scripts/install-tv-app.sh.

# SSH target for the Raspberry Pi
PI_HOST=pi@192.168.1.20
# The TV's IP address (Developer Mode must list this computer's IP as host)
TV_IP=192.168.1.50
# Where the TV app loads the dashboard from (the Pi, port from config)
DASHBOARD_URL=http://192.168.1.20:8080/
# Tizen Certificate Manager profile used to sign the TV app
CERT_PROFILE=MyTV
